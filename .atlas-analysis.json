  "keyFeatures": [
    "Usage-based billing with real-time metering",
    "Credit systems and top-ups",
    "Seat-based pricing with per-seat limits",
    "Subscription management (upgrades, downgrades, cancellations)",
    "Custom pricing for enterprise customers",
    "Stripe integration with webhook handling",
    "Embeddable checkout flows",
    "Analytics and usage insights",
    "Multi-tenancy support with organizations",
    "Self-hosted or cloud deployment"
  ],
  "publicApiSurface": [
    "POST /attach - Attach products to customers",
    "POST /check - Check feature access and usage",
    "POST /track - Record usage events",
    "POST /cancel - Cancel subscriptions",
    "POST /checkout - Create checkout sessions",
    "POST /customers/* - Customer management",
    "POST /products/* - Product and plan management",
    "POST /features/* - Feature management",
    "POST /balances/* - Balance operations",
    "POST /entities/* - Entity management",
    "POST /events/* - Event tracking",
    "POST /query - Analytics queries",
    "POST /insights/* - Usage insights"
  ]
