  "keyFeatures": [
    "Flexible pricing models (subscriptions, usage-based, credits, seat-based)",
    "Three core API functions: attach, check, track",
    "Real-time usage metering and limits",
    "Automatic subscription management",
    "Feature entitlements and access control",
    "Credit and balance systems",
    "Stripe integration for payments",
    "Usage analytics and insights",
    "Referral and rewards programs",
    "Multi-tenant organization support",
    "Self-hostable with Docker",
    "React dashboard for management"
  ],
  "publicApiSurface": [
    "POST /attach - Attach products to customers",
    "POST /check - Check feature access and usage",
    "POST /track - Track usage events",
    "POST /cancel - Cancel subscriptions",
    "POST /checkout - Create checkout sessions",
    "POST /setup_payment - Setup payment methods",
    "GET/POST /products - Manage products and plans",
    "GET/POST /features - Manage features",
    "GET/POST /customers - Manage customers",
    "GET/POST /entities - Manage entities (seats)",
    "GET /invoices - List invoices",
    "POST /query - Query analytics",
    "GET /insights - Get usage insights",
    "POST /customers/{id}/billing_portal - Access billing portal",
    "POST /subscriptions/update - Update subscriptions",
    "POST /subscriptions/preview_update - Preview subscription changes",
    "POST /reward_programs - Manage reward programs",
    "POST /referrals - Manage referral codes"
  ]
