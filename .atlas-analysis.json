  "keyFeatures": [
    "Flexible pricing models (subscriptions, usage-based, credits, seat-based)",
    "Three-function API (attach, check, track)",
    "Real-time usage tracking and limits",
    "Stripe integration with webhook handling",
    "Usage analytics and insights",
    "Referral and rewards programs",
    "Entity-based balances for multi-tenant apps",
    "Automatic upgrade/downgrade flows",
    "Custom pricing for enterprise customers",
    "Self-hostable with Docker"
  ],
  "publicApiSurface": [
    "POST /v1/attach - Purchase or upgrade to a product/plan",
    "POST /v1/check - Check customer access to products or features",
    "POST /v1/track - Record usage events",
    "POST /v1/checkout - Create Stripe checkout session",
    "POST /v1/cancel - Cancel customer subscription",
    "GET /v1/balances - Get customer balance information",
    "POST /v1/customers - Create customer",
    "GET /v1/customers/:id - Get customer details",
    "PATCH /v1/customers/:id - Update customer",
    "GET /v1/products - List products/plans",
    "POST /v1/products - Create product",
    "GET /v1/features - List features",
    "POST /v1/features - Create feature",
    "GET /v1/entities - List entities",
    "POST /v1/entities - Create entity",
    "GET /v1/events - List usage events",
    "POST /v1/referrals - Create referral",
    "GET /v1/insights - Get analytics insights"
  ]
